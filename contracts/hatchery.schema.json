{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gen142 Hatchery R0 shape only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "abi",
    "hatchery_id",
    "boot_id",
    "observed_utc",
    "expires_utc",
    "platform",
    "limits",
    "adapters",
    "owners",
    "admission_state"
  ],
  "properties": {
    "abi": {
      "const": "gen142.hatchery/0"
    },
    "hatchery_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "boot_id": {
      "type": "string",
      "format": "uuid"
    },
    "observed_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_utc": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "availability"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux",
            "windows",
            "macos"
          ]
        },
        "arch": {
          "enum": [
            "arm64",
            "x86_64"
          ]
        },
        "availability": {
          "enum": [
            "intermittent",
            "continuous"
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_attempts",
        "cpu_millis",
        "memory_bytes",
        "workspace_bytes",
        "log_bytes",
        "lifetime_seconds",
        "provider_requests",
        "max_usd"
      ],
      "properties": {
        "active_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "cpu_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "workspace_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "log_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "lifetime_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1099511627776
        },
        "provider_requests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "max_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "adapters": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "version",
          "binding_ref",
          "model_identity",
          "capabilities",
          "assay_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "kind": {
            "enum": [
              "ollama",
              "provider_api",
              "cli"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "binding_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "model_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "digest",
                  "provider_alias"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "assay_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisor_ref",
        "state_owner_ref",
        "admission_ref"
      ],
      "properties": {
        "supervisor_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "state_owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "admission_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "admission_state": {
      "enum": [
        "UNADMITTED",
        "HOLD",
        "ADMITTED"
      ]
    }
  }
}
