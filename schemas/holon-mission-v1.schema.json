{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hfo.holon-mission.v1",
  "title": "HFO Gen142 Holon Mission v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema", "mission_id", "actor_id", "parent_actor_id", "carrier_id",
    "domain", "domain_explicit", "intent", "fitness", "verifier",
    "deadline_utc", "max_attempts", "max_spend_usd", "effect_ceiling",
    "receipt_sink", "semantic_owner", "provider_policy", "human_boundaries",
    "control_plane", "promotion"
  ],
  "properties": {
    "schema": {"const": "hfo.holon-mission.v1"},
    "mission_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "parent_actor_id": {"type": ["string", "null"]},
    "carrier_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "domain_explicit": {"type": "boolean"},
    "intent": {"type": "string", "minLength": 1},
    "fitness": {
      "type": "object",
      "required": ["primary", "external_verification_required"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "external_verification_required": {"const": true}
      }
    },
    "verifier": {
      "type": "object",
      "required": ["id", "frozen"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "frozen": {"const": true}
      }
    },
    "deadline_utc": {"type": "string", "minLength": 1},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
    "max_spend_usd": {"type": "number", "minimum": 0},
    "effect_ceiling": {"type": "string", "minLength": 1},
    "receipt_sink": {"type": "string", "minLength": 1},
    "semantic_owner": {"type": "string", "minLength": 1},
    "provider_policy": {
      "type": "object",
      "required": ["role", "frontier_required", "provider_live", "provider_class", "allow_local_fallback"],
      "properties": {
        "role": {"const": "leaf"},
        "frontier_required": {"type": "boolean"},
        "provider_live": {"type": "boolean"},
        "provider_class": {"type": "string"},
        "allow_local_fallback": {"type": "boolean"}
      }
    },
    "human_boundaries": {
      "type": "array",
      "items": {"enum": ["secret", "oauth", "2fa", "payment", "permission", "protected_merge", "irreversible_external_submit"]},
      "uniqueItems": true
    },
    "control_plane": {
      "type": "object",
      "required": ["new_control_plane", "recover_probe_repair_completed"],
      "properties": {
        "new_control_plane": {"type": "boolean"},
        "recover_probe_repair_completed": {"type": "boolean"},
        "retired_owner": {"type": ["string", "null"]},
        "gap_evidence_ref": {"type": ["string", "null"]}
      }
    },
    "promotion": {
      "type": "object",
      "required": ["requested", "verifier_receipt", "consumer_ack"],
      "properties": {
        "requested": {"type": "boolean"},
        "verifier_receipt": {"type": ["string", "null"]},
        "consumer_ack": {"type": ["string", "null"]}
      }
    }
  }
}
