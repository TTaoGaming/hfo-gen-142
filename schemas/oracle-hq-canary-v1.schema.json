{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TTaoGaming/hfo-gen-142/main/schemas/oracle-hq-canary-v1.schema.json",
  "title": "Gen142 Oracle HQ Canary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "observed_utc", "hostname", "arch", "boot_utc", "uptime_seconds",
    "mem_total_bytes", "mem_available_bytes", "disk_total_bytes", "disk_free_bytes",
    "load_1m", "tailscaled_active", "desktop_commander_active", "cdev_runner_active",
    "effect_class", "tao_relay_required"
  ],
  "properties": {
    "schema": {"const": "hfo.oracle-hq-canary.v1"},
    "observed_utc": {"type": "string", "format": "date-time"},
    "hostname": {"type": "string", "minLength": 1},
    "arch": {"enum": ["aarch64", "arm64"]},
    "boot_utc": {"type": "string", "format": "date-time"},
    "uptime_seconds": {"type": "number", "minimum": 0},
    "mem_total_bytes": {"type": "integer", "minimum": 1},
    "mem_available_bytes": {"type": "integer", "minimum": 0},
    "disk_total_bytes": {"type": "integer", "minimum": 1},
    "disk_free_bytes": {"type": "integer", "minimum": 0},
    "load_1m": {"type": "number", "minimum": 0},
    "tailscaled_active": {"type": "boolean"},
    "desktop_commander_active": {"type": "boolean"},
    "cdev_runner_active": {"type": "boolean"},
    "gen140_runner_active": {"type": "boolean"},
    "effect_class": {"const": "NO_EFFECT"},
    "tao_relay_required": {"const": false}
  }
}
