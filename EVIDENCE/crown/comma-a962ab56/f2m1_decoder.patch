+def _expand_f2m1(models: bytes) -> bytes:
+    """Expand exact F2M1 metadata back to canonical F24S bytes."""
+    if not models.startswith(F2M1_MAGIC):
+        return models
+    base = 4 + IHS2_BODY_BYTES + WANS_BODY_BYTES
+    if len(models) <= base + 1 + 6 + 96 + 12 + 9 + 24 + 6:
+        raise ResidualArchiveError("truncated F2M1 model payload")
+    compact = models[base:]
+    if compact[0] != 0x0F:
+        raise ResidualArchiveError("unsupported F2M1 metadata flags")
+    offset = 1
+    counts = compact[offset:offset + 6]; offset += 6
+    basis_bits = int.from_bytes(counts[:3], "little")
+    residual_bits = int.from_bytes(counts[3:], "little")
+    scales = compact[offset:offset + 96]; offset += 96
+    factors = compact[offset:offset + 12]; offset += 12
+    biases = compact[offset:offset + 9]; offset += 9
+    lengths = compact[offset:offset + 24]; offset += 24
+    ks = compact[offset:offset + 6]; offset += 6
+    basis_bytes = (basis_bits + 7) // 8
+    residual_bytes = (residual_bits + 7) // 8
+    end = offset + basis_bytes + residual_bytes
+    if end >= len(compact):
+        raise ResidualArchiveError("truncated F2M1 carrier or selector")
+    carrier_tail = compact[offset:end]
+    selector = compact[end:]
+    factor_values = list(factors)
+    bias_values = _unpack_fixed_bits(biases, 12, 6, signed=True)
+    length_values = _unpack_fixed_bits(lengths, 16, 12)
+    k_values = _unpack_fixed_bits(ks, 12, 4)
+    predictor = struct.pack("<12h", *factor_values) + struct.pack("<12b", *bias_values)
+    canonical_cap = (
+        counts + scales + predictor + struct.pack("<16H", *length_values)
+        + bytes(k_values) + carrier_tail
+    )
+    return F24S_MAGIC + models[4:base] + canonical_cap + selector
+
