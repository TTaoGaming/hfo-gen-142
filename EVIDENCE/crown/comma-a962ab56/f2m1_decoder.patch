+def _unpack_fixed_bits(raw: bytes, count: int, width: int, *, signed: bool = False) -> list[int]:
+    values: list[int] = []
+    acc = available = offset = 0
+    for _ in range(count):
+        while available < width:
+            if offset >= len(raw):
+                raise ResidualArchiveError("truncated F2M1 packed metadata")
+            acc = (acc << 8) | raw[offset]
+            offset += 1
+            available += 8
+        available -= width
+        value = (acc >> available) & ((1 << width) - 1)
+        acc &= (1 << available) - 1 if available else 0
+        if signed and value & (1 << (width - 1)):
+            value -= 1 << width
+        values.append(value)
+    return values
+
