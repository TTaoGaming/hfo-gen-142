+    def _eval_checkpoint_context(self):
+        # This opt-in is intentionally limited to the pinned, data-only packing task.
+        names = ("run.py", "evaluate.py", "packing_generations.py", "parent.pck", "initial.py")
+        return {name: hashlib.sha256(Path(name).read_bytes()).hexdigest() for name in names}
+
+    def _read_eval_checkpoint(self, generation):
+        folder = Path(self.results_dir) / f"gen_{generation}"
+        target = folder / "accepted-proposal.json"
+        if not target.is_file() or target.stat().st_size > 262144:
+            raise RuntimeError("RECOVERY_HOLD_NO_ACCEPTED_PROPOSAL")
+        data = json.loads(target.read_bytes())
+        if (data.get("version") != 1 or data.get("generation") != generation
+                or data.get("context") != self._eval_checkpoint_context()
+                or data.get("code_sha256") != hashlib.sha256((folder / f"main.{self.lang_ext}").read_bytes()).hexdigest()):
+            raise RuntimeError("RECOVERY_HOLD_CHECKPOINT_MISMATCH")
+        return data
